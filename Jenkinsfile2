pipeline {

    agent any

    environment {

        // ==============================
        // AWS CONFIGURATION
        // ==============================
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '093366266423'

        ECR_REGISTRY = '093366266423.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPOSITORY = 'bookmyshow'

        DOCKER_IMAGE = "${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

        // ==============================
        // EKS CONFIGURATION
        // ==============================
        EKS_CLUSTER = 'bookmyshow-eks'
        K8S_DEPLOYMENT = 'bms-app'
        K8S_CONTAINER = 'bms-container'

        // ==============================
        // SONARQUBE CONFIGURATION
        // ==============================
        SONAR_PROJECT_KEY = 'BMS'
        SONAR_PROJECT_NAME = 'BMS'
    }

    stages {

        // ==========================================
        // 1. CHECKOUT
        // ==========================================
        stage('Checkout') {
            steps {
                echo "===== Checkout Source Code ====="

                checkout scm
            }
        }

        // ==========================================
        // 2. SONARQUBE ANALYSIS
        // ==========================================
        stage('SonarQube Analysis') {
            steps {
                echo "===== SonarQube Analysis ====="

                withSonarQubeEnv('sonar-server') {
                    script {
                        def scannerHome = tool 'sonar-scanner'

                        sh """
                            echo "Running SonarQube Scanner..."

                            ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                -Dsonar.projectName=${SONAR_PROJECT_NAME} \
                                -Dsonar.sources=bookmyshow-app \
                                -Dsonar.exclusions=bookmyshow-app/node_modules/**
                        """
                    }
                }
            }
        }

        // ==========================================
        // 3. BUILD DOCKER IMAGE
        // ==========================================
        stage('Build Docker Image') {
            steps {
                echo "===== Building Docker Image ====="

                sh '''
                    docker build \
                        -t ${DOCKER_IMAGE} \
                        bookmyshow-app
                '''
            }
        }

        // ==========================================
        // 4. LOGIN TO AWS ECR
        // ==========================================
        stage('Login to ECR') {
            steps {
                echo "===== Login to Amazon ECR ====="

                sh '''
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}
                '''
            }
        }

        // ==========================================
        // 5. PUSH IMAGE TO ECR
        // ==========================================
        stage('Push Image to ECR') {
            steps {
                echo "===== Pushing Image to ECR ====="

                sh '''
                    docker push ${DOCKER_IMAGE}
                '''
            }
        }

        // ==========================================
        // 6. CONFIGURE EKS
        // ==========================================
        stage('Configure EKS') {
            steps {
                echo "===== Configuring EKS ====="

                sh '''
                    aws eks update-kubeconfig \
                        --region ${AWS_REGION} \
                        --name ${EKS_CLUSTER}

                    kubectl get nodes
                '''
            }
        }

        // ==========================================
        // 7. DEPLOY TO EKS
        // ==========================================
        stage('Deploy to EKS') {
            steps {
                echo "===== Deploying BookMyShow to EKS ====="

                sh '''
                    kubectl apply -f deployment.yml

                    kubectl set image deployment/${K8S_DEPLOYMENT} \
                        ${K8S_CONTAINER}=${DOCKER_IMAGE}

                    kubectl rollout status deployment/${K8S_DEPLOYMENT}
                '''
            }
        }

        // ==========================================
        // 8. VERIFY DEPLOYMENT
        // ==========================================
        stage('Verify Deployment') {
            steps {
                echo "===== Verifying Kubernetes Deployment ====="

                sh '''
                    echo "----- Pods -----"
                    kubectl get pods -o wide

                    echo "----- Deployment -----"
                    kubectl get deployment ${K8S_DEPLOYMENT}

                    echo "----- Services -----"
                    kubectl get services

                    echo "===== Deployment Verification Completed ====="
                '''
            }
        }
    }

    // ==========================================
    // POST ACTIONS
    // ==========================================
    post {

        always {
            echo "===== CI/CD Pipeline Completed ====="
            echo "Build Number: ${BUILD_NUMBER}"
            echo "Build Status: ${currentBuild.currentResult}"
        }

        success {
            echo "=========================================="
            echo "BookMyShow CI/CD Pipeline SUCCESS"
            echo "=========================================="
        }

        failure {
            echo "=========================================="
            echo "BookMyShow CI/CD Pipeline FAILED"
            echo "Check the Console Output."
            echo "=========================================="
        }
    }
}
