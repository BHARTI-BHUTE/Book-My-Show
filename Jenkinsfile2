pipeline {
    agent any

    environment {
        // GitHub Repository
        GITHUB_REPO = 'https://github.com/BHARTI-BHUTE/Book-My-Show.git'
        GITHUB_BRANCH = 'main'

        // AWS / ECR
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '093366266423'
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REPOSITORY = 'bookmyshow'
        DOCKER_IMAGE = "${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

        // EKS
        EKS_CLUSTER_NAME = 'bookmyshow-eks'

        // SonarQube
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: "${GITHUB_BRANCH}",
                    url: "${GITHUB_REPO}"

                sh '''
                    echo "===== Git Repository ====="
                    git remote -v

                    echo "===== Current Branch ====="
                    git branch

                    echo "===== Project Files ====="
                    ls -la
                '''
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                    echo "===== Node.js Version ====="
                    node --version

                    echo "===== npm Version ====="
                    npm --version

                    echo "===== Installing Dependencies ====="
                    cd bookmyshow-app
                    npm install

                    echo "===== Checking Test Script ====="
                    if npm run | grep -q " test"; then
                        echo "Test script found. Running npm test..."
                        npm test
                    else
                        echo "No npm test script configured. Skipping test execution."
                    fi
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                        echo "===== SonarQube Analysis ====="

                        $SCANNER_HOME/bin/sonar-scanner \
                            -Dsonar.projectName=BMS \
                            -Dsonar.projectKey=BMS
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    waitForQualityGate(
                        abortPipeline: false,
                        credentialsId: 'Sonar-token'
                    )
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                dependencyCheck(
                    additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit',
                    odcInstallation: 'DP-Check'
                )

                dependencyCheckPublisher(
                    pattern: '**/dependency-check-report.xml'
                )
            }
        }

        stage('Trivy File System Scan') {
            steps {
                sh '''
                    echo "===== Trivy File System Scan ====="

                    trivy fs . \
                        --format table \
                        -o trivyfs.txt

                    echo "Trivy scan completed."
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    echo "===== Docker Build ====="

                    docker build --no-cache \
                        -t ${DOCKER_IMAGE} \
                        -f bookmyshow-app/Dockerfile \
                        bookmyshow-app

                    echo "Docker image created:"
                    docker images | grep bookmyshow
                '''
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                sh '''
                    echo "===== AWS Account ====="
                    aws sts get-caller-identity

                    echo "===== ECR Login ====="

                    aws ecr get-login-password \
                        --region ${AWS_REGION} | \
                    docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}
                '''
            }
        }

        stage('Push Docker Image to ECR') {
            steps {
                sh '''
                    echo "===== Pushing Docker Image to ECR ====="

                    docker push ${DOCKER_IMAGE}

                    echo "Docker image successfully pushed:"
                    echo ${DOCKER_IMAGE}
                '''
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh '''
                    echo "===== AWS Credentials Verification ====="
                    aws sts get-caller-identity

                    echo "===== Updating kubeconfig ====="

                    aws eks update-kubeconfig \
                        --region ${AWS_REGION} \
                        --name ${EKS_CLUSTER_NAME}

                    echo "===== Kubernetes Context ====="
                    kubectl config current-context

                    echo "===== Applying Deployment ====="
                    kubectl apply -f deployment.yml

                    echo "===== Applying Service ====="
                    kubectl apply -f service.yml

                    echo "===== Kubernetes Deployment ====="
                    kubectl get deployment

                    echo "===== Kubernetes Pods ====="
                    kubectl get pods

                    echo "===== Kubernetes Service ====="
                    kubectl get svc
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'trivyfs.txt',
                allowEmptyArchive: true
            )

            echo "===== CI/CD Pipeline Completed ====="
            echo "Build Number: ${BUILD_NUMBER}"
            echo "Build Status: ${currentBuild.currentResult}"
        }

        success {
            echo "BookMyShow CI/CD Pipeline completed successfully."
        }

        failure {
            echo "BookMyShow CI/CD Pipeline failed. Check the Console Output."
        }
    }
}
